# Database
DATABASE_URL=postgresql+asyncpg://etornie:etornie_dev@localhost:5432/etornie

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Together AI
TOGETHER_API_KEY=
TOGETHER_MODEL=openai/gpt-oss-20b
TOGETHER_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
# Agent orchestrator LLM (tool-calling, non-reasoning, fast)
TOGETHER_AGENT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Vision model for document intake (image_url content parts required)
TOGETHER_VISION_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct
# Title generation for chat sessions (cheap, fast, non-reasoning)
TOGETHER_TITLE_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# File Storage
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173"]

# WhatsApp Business API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Email (SMTP) — server-side transactional mail (registration OTP, case +
# payment notifications). Works with any relay: Amazon SES, Postmark,
# Mailgun, Gmail, etc. Leave SMTP_HOST empty to disable email in local dev.
# Deliverability (SPF/DKIM/DMARC): see docs/EMAIL_DELIVERABILITY.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Port 587 = STARTTLS (default). For port 465 (implicit TLS) set SMTP_USE_TLS=true.
SMTP_STARTTLS=true
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Etornie

# ClamAV malware scanning for uploads (#55). Disabled by default. Set
# CLAMAV_ENABLED=true to scan. Use CLAMAV_HOST=clamav inside docker compose,
# or localhost when the backend runs outside compose against the published
# 3310 port. An enabled-but-unreachable daemon fails CLOSED (upload rejected).
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

# Groq (optional - Together AI is primary for EtornieGPT)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# EUIPO API
EUIPO_API_KEY=
EUIPO_API_SECRET=
EUIPO_BASE_URL=https://api-sandbox.euipo.europa.eu
EUIPO_AUTH_URL=https://auth-sandbox.euipo.europa.eu/oidc/accessToken

# IP Australia API (register at portal.api.ipaustralia.gov.au)
IPAUS_CLIENT_ID=
IPAUS_CLIENT_SECRET=
IPAUS_BASE_URL=https://production.api.ipaustralia.gov.au/public/australian-trade-mark-search-api/v1
IPAUS_TOKEN_URL=https://production.api.ipaustralia.gov.au/public/external-token-api/v1/access_token

# Agent Loop
AGENT_LOOP_BASE_URL=http://localhost:8000
AGENT_LOOP_ADMIN_EMAIL=admin@example.com
AGENT_LOOP_ADMIN_PASSWORD=

# Demo Script
WHATSAPP_DEMO_TEMPLATE=hello_world
WHATSAPP_DEMO_LANGUAGE=en_US

# Application
DEBUG=false

# UK IPO robot - representative / declarant block
# These values are submitted as the "Representative details" on every
# UK IPO filing. IPO requires a UK-based representative (Country must be
# United Kingdom, Guernsey, Jersey, or Gibraltar). Update with the real
# firm address when a UK agent relationship is in place.
UKIPO_REP_ENTITY_TYPE=IP Professional
UKIPO_REP_NAME=
UKIPO_REP_EMAIL=
UKIPO_REP_PHONE=
UKIPO_REP_ADDRESS_LINE1=
UKIPO_REP_ADDRESS_LINE2=
UKIPO_REP_CITY=
UKIPO_REP_POSTCODE=
UKIPO_REP_COUNTRY=United Kingdom
UKIPO_DECLARANT_NAME=
UKIPO_SCREENSHOT_DIR=/tmp/ukipo-screenshots

# EtornieGPT Payment (Faz 5.6 - x402)
ETORNIEGPT_PAYMENT_VAULT=
ETORNIEGPT_PAYMENT_LAMPORTS=100000

# BRAID agent (services/braid) shared bearer token for /braid/* endpoints.
# Generate any random string and copy the same value into services/braid/.env.
# Empty value disables the entire braid router (fail-closed).
BRAID_INTERNAL_TOKEN=

# Stripe (sandbox/test mode) — required for the card-payment lane
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-12-18.acacia

# Sentry monitoring (optional). Empty SENTRY_DSN keeps the SDK
# uninitialised so the app runs unchanged. Backend uses SENTRY_DSN;
# the Next.js dashboard reads NEXT_PUBLIC_SENTRY_DSN for the browser
# bundle. Match the deployment environment string ("staging", "production",
# etc.) across both so events group cleanly.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
