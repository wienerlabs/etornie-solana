# Etornie dashboard (Next.js) environment.
# Copy to `.env.local`:  cp dashboard/.env.local.example dashboard/.env.local
# Only NEXT_PUBLIC_* vars are exposed to the browser.

# Backend API base URL (the FastAPI service).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Solana cluster used by the wallet/explorer links (optional — defaults
# to devnet in the code).
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_CLUSTER_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Moca chain explorer for cross-chain attestation tx links (#73).
NEXT_PUBLIC_MOCA_EXPLORER_URL=https://testnet-scan.mocachain.org

# Moca Chain testnet id, offered as an optional chain to WalletConnect
# sessions (#72). Matches services/api moca_chain_id. Optional — the code
# defaults to 222888.
NEXT_PUBLIC_MOCA_CHAIN_ID=222888

# WalletConnect Cloud project id (https://cloud.walletconnect.com). Enables
# the "WalletConnect" option (QR pairing for mobile wallets) on the login
# and profile pages (#72). Optional — when unset, only injected EIP-6963
# wallets (MetaMask, Rabby, ...) are offered and the WalletConnect button is
# hidden, since v2 cannot pair without a project id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
