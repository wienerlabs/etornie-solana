# ──────────────────────────────────────────────────────────────────────
# OpenServ BRAID Agent — Environment Variables
# Get these from https://platform.openserv.ai → Developer → Your Agents
# ──────────────────────────────────────────────────────────────────────

# REQUIRED: API secret key for your registered OpenServ agent.
OPENSERV_API_KEY=

# Default HTTP port the agent server listens on (default: 7378).
PORT=7378

# Optional: disables the dev tunnel and runs HTTP-only.
# Set to "true" in production (when you expose the port via your own proxy).
# DISABLE_TUNNEL=true

# Optional: only required if you call agent.process() with direct OpenAI calls.
# OPENSERV's run-less capabilities and this.generate() do NOT need this.
# OPENAI_API_KEY=

# Optional: custom OpenServ proxy URL (only needed for self-hosted setups).
# OPENSERV_PROXY_URL=

# Optional: shared bearer token to authenticate inbound requests from OpenServ.
# OPENSERV_AUTH_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# Etornie backend (services/api) — capabilities call back into FastAPI
# ──────────────────────────────────────────────────────────────────────

# Base URL of the local Etornie FastAPI backend. Defaults to localhost:8000.
ETORNIE_API_BASE_URL=http://localhost:8000

# Shared bearer token for /braid/* endpoints on the FastAPI backend.
# Must match BRAID_INTERNAL_TOKEN in the api .env. Empty value disables
# any capability that calls back into Etornie.
BRAID_INTERNAL_TOKEN=
